POSTGRES_DB=court_docs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55432/court_docs

# SMTP необязателен для распознавания документов.
# Нужен только для реальной отправки документов по e-mail.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_RECIPIENT=
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# Необязательно.
# Если tesseract.exe доступен через PATH, эту переменную можно не задавать.
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=court-documents
MINIO_SECURE=false

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DOCUMENT_TOPIC=document.processing
KAFKA_DLQ_TOPIC=document.processing.dlq